# Copy to .env to override the defaults (docker compose reads .env automatically).
# The Spring Boot app reads the same names from the process environment and falls back
# to these defaults, so no .env is needed for a default local setup.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minidood
DB_USER=minidood
DB_PASSWORD=minidood
# Host port of the containerized API (docker compose up).
APP_PORT=8080
